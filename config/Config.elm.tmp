module Config exposing (config, limitedNetworks, logoutUrl, plugins)

import Iknaio
import Plugin
import Theme.Theme exposing (Theme)


logoutUrl : String
logoutUrl =
    "{{VITE_LOGOUT_URL}}"


{-| Build-time SEED for Model.NetworkCapabilities: networks listed here are
treated as capability-less lite networks (no relations/clusters/tags) until
/stats arrives — backends that declare a `capabilities` list override the
seed at runtime, so this only covers non-declaring backends and requests
fired before /stats. Comma separated, e.g. "bnb,arb". An unreplaced
placeholder seeds nothing (the server declarations still apply).
-}
limitedNetworks : List String
limitedNetworks =
    "{{VITE_LIMITED_NETWORKS}}"
        |> String.split ","
        |> List.map (String.trim >> String.toLower)
        |> List.filter (\n -> n /= "" && not (String.contains "{" n))


config : { theme : Theme }
config =
    { theme = Iknaio.theme
    }


plugins : Plugin.Plugins
plugins =
    Plugin.empty
