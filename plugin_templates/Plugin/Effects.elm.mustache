module Plugin.Effects exposing (..)

{{#plugins}}
import {{package}}.Msg
import {{package}}.Interface.Effects
{{/plugins}}
import Plugin.Msg
import PluginInterface.Effects


type alias Plugins =
    { {{#plugins}}{{name}} : PluginInterface.Effects.Effects {{package}}.Msg.Msg
    {{^last}}, {{/last}}{{/plugins}}
    }


search : String -> List (Cmd Plugin.Msg.Msg)
search query =
    [ {{#plugins}}
        {{package}}.Interface.Effects.plugin.search
            |> Maybe.map
                (\fun ->
                    fun query
                        |> Cmd.map Plugin.Msg.{{package}}Msg
                )
    {{^last}}, {{/last}}{{/plugins}}
    ]
        |> List.filterMap identity
