module Config exposing (config, isLimitedNetwork, limitedNetworks, logoutUrl, plugins)

import Iknaio
import Plugin
import Theme.Theme exposing (Theme)


logoutUrl : String
logoutUrl =
    "{{VITE_LOGOUT_URL}}"


{-| Networks served by a backend without precomputed relations (e.g.
iknaio-rest): counterparty listing is unavailable there, so the
UI hides features that need it (neighbor tables, cluster views). Comma
separated, e.g. "eth,bnb". An unreplaced placeholder means no limits.
-}
limitedNetworks : List String
limitedNetworks =
    "{{VITE_LIMITED_NETWORKS}}"
        |> String.split ","
        |> List.map (String.trim >> String.toLower)
        |> List.filter (\n -> n /= "" && not (String.contains "{" n))


isLimitedNetwork : String -> Bool
isLimitedNetwork network =
    List.member (String.toLower network) limitedNetworks


config : { theme : Theme }
config =
    { theme = Iknaio.theme
    }


plugins : Plugin.Plugins
plugins =
    Plugin.empty
