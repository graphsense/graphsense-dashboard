-- Additive, not first-wins: every plugin renders its own tooltip. A plugin's hook
-- cannot report "nothing to show" -- `Components.Tooltip.Model` is opaque, so the hook
-- returns `Just` whatever `Tooltip.view` gives it, which is an empty node while closed
-- -- so short-circuiting on the first `Just` silently swallowed the tooltips of every
-- plugin but the alphabetically first one.
tooltip : Plugin.Model.ModelState -> View.Config -> List (Html Model.Msg)
tooltip states vc =
    [ {{#plugins}}
            Maybe.map2
                (\fun ->
                    fun vc
                )
                {{package}}.Interface.View.plugin.tooltip
                states.{{name}}
            |> Maybe.Extra.join
            |> Maybe.map (List.map (Html.map Plugin.Msg.{{package}}Msg))
    {{^last}}, {{/last}}{{/plugins}}
    ]
        |> List.filterMap identity
        |> List.concat
        |> List.map (Html.map Model.PluginMsg)


