getLegendIconItems: View.Config -> List ({ description : String, icon : Html Model.Msg, label : String })
getLegendIconItems vc =
    let
        mapItem wMsg {description, icon, label} = {description=description, icon = icon |> Html.map wMsg, label = label}
    in
    [ {{#plugins}}
        {{package}}.Interface.View.plugin.getLegendIconItems
            |> Maybe.map (\f -> f vc |> List.map (mapItem Plugin.Msg.{{package}}Msg))
    {{^last}}, {{/last}}{{/plugins}}
    ] 
    |> List.filterMap identity
    |> List.concat
    |> List.map (mapItem Model.PluginMsg)
